<mxfile host="archdiag"><diagram id="p0" name="Раскатка агентом"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1488" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Раскатка агентом" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="36.0" width="880.0" height="30.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Шаги docs/AGENT.md: каждый заканчивается проверкой, дальше без неё не идти" style="text;html=1;fontSize=13.5;fontColor=#6B7280;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="66.0" width="880.0" height="22.0" as="geometry"/></mxCell><mxCell id="n_start" value='&lt;b&gt;Хост готов&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;macOS, Apple Silicon, Python 3.12&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="120.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_s0" value='&lt;b&gt;0. Разведка&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;RAM, runtime, где данные, cwd агента&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="244.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_s1" value='&lt;b&gt;1. Установка&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;venv, pip install, pytest&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="368.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_s2" value='&lt;b&gt;2. Локальные модели&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;LM Studio / Ollama, models.yaml&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="476.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_c2" value='&lt;b&gt;datavault check&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;все маршруты ok?&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF1E2;strokeColor=#C7741F;fontColor=#8A4A0F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="600.0" width="240.0" height="157.0" as="geometry"/></mxCell><mxCell id="n_fix" value='&lt;b&gt;Подобрать модели&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;по объёму RAM, cloud запрещён&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0504D;fontColor=#8B1E1B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680.0" y="647.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_s3" value='&lt;b&gt;3. Подключение к агенту&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;MCP, hooks, permissions.deny&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="810.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_s3h" value='&lt;b&gt;Утверждение&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;человек смотрит diff settings.json&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontColor=#1E5E3A;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="802.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_s4" value='&lt;b&gt;4. Hardening&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;harden --tighten, FileVault&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="926.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_s5" value='&lt;b&gt;5. Приёмка&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;dlptest-дело, leakcheck, hook-тесты&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="1034.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_c5" value="&lt;b&gt;0 утечек, все guards on?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF1E2;strokeColor=#C7741F;fontColor=#8A4A0F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="1158.0" width="240.0" height="132.0" as="geometry"/></mxCell><mxCell id="n_stop" value='&lt;b&gt;Стоп&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;отчёт человеку, данные не грузить&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0504D;fontColor=#8B1E1B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680.0" y="1184.5" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_done" value='&lt;b&gt;Готово к делам&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;отчёт о раскатке&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="1335.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B6575;strokeWidth=1.6;fontSize=11.5;fontColor=#374151;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_start" target="n_s0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B6575;strokeWidth=1.6;fontSize=11.5;fontColor=#374151;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_s0" target="n_s1"><mxGeometry relative="1" as="geometry"></mxGeometry></