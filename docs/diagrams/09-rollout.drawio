16.0" height="16.0" as="geometry"/></mxCell><mxCell id="lgt3" value="проверка" style="text;html=1;fontSize=12.5;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="472.0" y="1458.0" width="66.0" height="20.0" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;arcSize=25;fillColor=#FDECEC;strokeColor=#C0504D;" vertex="1" parent="1"><mxGeometry x="556.0" y="1460.0" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="lgt4" value="стоп, разбор" style="text;html=1;fontSize=12.5;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580.0" y="1458.0" width="94.0" height="20.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
