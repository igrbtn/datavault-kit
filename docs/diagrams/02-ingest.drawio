<mxfile host="archdiag"><diagram id="p0" name="DataVault. Конвейер ингеста"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="906" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataVault. Конвейер ингеста" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="36.0" width="880.0" height="30.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Найти значение один раз где угодно, вычистить его во всём деле" style="text;html=1;fontSize=13.5;fontColor=#6B7280;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="66.0" width="880.0" height="22.0" as="geometry"/></mxCell><mxCell id="n_src" value='&lt;b&gt;Источники дела&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;csv xlsx docx pdf eml cfg env ps1&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#8A93A0;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="120.0" width="240.0" height="97.0" as="geometry"/></mxCell><mxCell id="n_parse" value='&lt;b&gt;Парсеры&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;куски по 1500 + таблицы&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="267.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_regex" value='&lt;b&gt;Regex + DLP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;IP, хосты, секреты, ПИНФЛ, телефоны&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#F1EDFB;strokeColor=#7A5AC8;fontColor=#4C2F96;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="380.0" width="240.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_hdr" value='&lt;b&gt;Заголовки колонок&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;правила, LLM для Name&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#F1EDFB;strokeColor=#7A5AC8;fontColor=#4C2F96;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="388.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_ner" value='&lt;b&gt;LLM NER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;qwen3-4b, только дословные&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#2A8C99;fontColor=#16616B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680.0" y="388.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_store" value='&lt;b&gt;Handle store&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;связывание ФИО, алиасы фамилий&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="509.0" width="240.0" height="81.0" as="geometry"/></mxCell><mxCell id="n_sweep" value='&lt;b&gt;Sweep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;словарь + падежи + телефоны&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360.0" y="640.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_pseudo" value='&lt;b&gt;Псевдо-куски&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;[[DV:PER:k3f9ab]]&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E7F5EC;strokeColor=#2E8B57;fontColor=#1E5E3A;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="753.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_emb" value='&lt;b&gt;Эмбеддинги&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;bge-m3 по псевдо-тексту&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#2A8C99;fontColor=#16616B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680.0" y="753.0" width="240.0" height="63.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B6575;strokeWidth=1.6;fontSize=11.5;fontColor=#374151;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_src" target="n_parse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B6575;strokeWidth=1.6;fontSize=11.5;fontColor=#374151;labelBackgroundColor=#FFFF