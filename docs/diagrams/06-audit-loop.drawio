<mxfile host="archdiag"><diagram id="p0" name="Цикл аудита утечек"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1074" pageHeight="857" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Цикл аудита утечек" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="36.0" width="994.0" height="30.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Тяжёлая локальная модель перечитывает псевдокорпус и ищет, что осталось незамаскированным" style="text;html=1;fontSize=13.5;fontColor=#6B7280;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="66.0" width="994.0" height="22.0" as="geometry"/></mxCell><mxCell id="n_src" value='&lt;b&gt;Сырые данные дела&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;CSV, docx, pdf, конфиги&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#8A93A0;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="250.0" height="81.0" as="geometry"/></mxCell><mxCell id="n_ingest" value='&lt;b&gt;ingest&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;правила + NER + типы колонок&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="412.0" y="129.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_pseudo" value='&lt;b&gt;Псевдокорпус&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;handles вместо значений&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784.0" y="120.0" width="250.0" height="81.0" as="geometry"/></mxCell><mxCell id="n_sample" value='&lt;b&gt;Выборка 60 чанков&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;seed фиксирован&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784.0" y="256.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_heavy" value='&lt;b&gt;qwen3.8-27b&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;LM Studio, 1 запрос за раз&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#2A8C99;fontColor=#16616B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784.0" y="374.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_json" value='&lt;b&gt;audit.json&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;находки со значениями, 600&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#8A93A0;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="784.0" y="530.0" width="250.0" height="81.0" as="geometry"/></mxCell><mxCell id="n_counts" value='&lt;b&gt;Счётчики&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;по типам, без значений&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="412.0" y="539.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_dec" value='&lt;b&gt;Утечка или шум?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;по форме и колонке&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF1E2;strokeColor=#C7741F;fontColor=#8A4A0F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="492.0" width="250.0" height="157.0" as="geometry"/></mxCell><mxCell id="n_rules" value='&lt;b&gt;Правка правил&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;regex, header, gate, stop-list&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="374.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_synth" value='&lt;b&gt;Синтетика&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;recall 1.0 / 0.997 / 1.0&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="256.0" width="250.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_done" value='&lt;b&gt;Допустимые мелочи&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;версии, обрывки, AD-группы&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=