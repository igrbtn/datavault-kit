<mxfile host="archdiag"><diagram id="p0" name="Путь одной записи: туда и обратно"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="837" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Путь одной записи: туда и обратно" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="36.0" width="1240.0" height="30.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Синтетический пример. Значения существуют только слева внизу и справа внизу, оба раза на этом Mac" style="text;html=1;fontSize=13.5;fontColor=#6B7280;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="66.0" width="1240.0" height="22.0" as="geometry"/></mxCell><mxCell id="z_there" value="ТУДА: INGEST И ЗАПРОСЫ" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F8FD;strokeColor=#B9CCE6;fontColor=#1F3A5F;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=0;container=1;collapsible=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="22.0" y="112.0" width="596.0" height="653.0" as="geometry"/></mxCell><mxCell id="z_back" value="ОБРАТНО: ОТЧЁТ И RENDER" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F7F7F9;strokeColor=#C9CDD6;fontColor=#4B5563;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=0;container=1;collapsible=0;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="702.0" y="112.0" width="596.0" height="653.0" as="geometry"/></mxCell><mxCell id="n_src" value='&lt;b&gt;Исходная строка в docx&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;Сервер srv-bkp01 (10.20.30.40), админ Иванов Иван, ivan@corp.local, пароль Qw3rty!&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0504D;fontColor=#8B1E1B;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_there"><mxGeometry x="18.0" y="38.0" width="560.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_det" value='&lt;b&gt;detect: правила + NER&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;HOST srv-bkp01 | IP 10.20.30.40 | PER Иванов Иван | EMAIL ivan@corp.local | SECRET Qw3rty!&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_there"><mxGeometry x="18.0" y="167.0" width="560.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_store" value="&lt;b&gt;Handle store (SQLite)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#4B5563;font-weight:normal&quot;&gt;srv-bkp01 = [[DV:HOST:u4pcsk]], Иванов Иван = [[DV:PER:k3m9qa]], формы 'Иванова', 'И. Иванов' - тот же handle&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_there"><mxGeometry x="18.0" y="296.0" width="560.0" height="97.0" as="geometry"/></mxCell><mxCell id="n_pseudo" value='&lt;b&gt;Псевдокорпус&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;Сервер [[DV:HOST:u4pcsk]] ([[DV:IP:asdgod]]), админ [[DV:PER:k3m9qa]], [[DV:EMAIL:7hf2pz]], пароль [[DV:SECRET:h2cgou]]&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_there"><mxGeometry x="18.0" y="443.0" width="560.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_tools" value='&lt;b&gt;search / aggregate / extract&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;ответы с handles, output guard режет всё, чего нет в псевдокорпусе&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#F1EDFB;strokeColor=#7A5AC8;fontColor=#4C2F96;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_there"><mxGeometry x="18.0" y="572.0" width="560.0" height="63.0" as="geometry"/></mxCell><mxCell id="n_agent" value='&lt;b&gt;Облачный агент&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;Сервер [[DV:HOST:u4pcsk]] ([[DV:IP:asdgod]]) ведёт [[DV:PER:k3m9qa]]; пароль в открытом виде в документе - риск&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AF;fontColor=#374151;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_back"><mxGeometry x="18.0" y="38.0" width="560.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_tmpl" value='&lt;b&gt;render(report.md, шаблон)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&gt;шаблон с handles уходит в vault; агент получает bytes, sha256, resolved=3, withheld=1&lt;/span&gt;' style="rounded=1;arcSize=10;absoluteArcSize=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=2;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2F5D9A;fontColor=#1F3A5F;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="z_back"><mxGeometry x="18.0" y="167.0" width="560.0" height="79.0" as="geometry"/></mxCell><mxCell id="n_resolve" value='&lt;b&gt;resolve локально&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#4B5563;font-weight:normal"&